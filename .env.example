# Repomedic Environment Configuration Template
# Copy this file to .env and adjust values for your local environment

# Environment Mode: development | test | production
REPOMEDIC_ENV=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Sandbox Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_DEFAULT_TIMEOUT=120
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0

# LLM Providers (for Agent Reasoning Engine)
# Required when running live agent repair loops
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REPOMEDIC_DEFAULT_MODEL=claude-3-7-sonnet
